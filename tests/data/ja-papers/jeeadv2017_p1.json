": 1, "type": "msq", "type_label": "One or More Correct", "marks": 4.0, "neg": -2.0, "partial": true, "chapter": "System of Particles and Rotational Motion", "q_img": "JEEADV2017_P1_P03_q.png", "sol_img": "JEEADV2017_P1_P03_sol.png", "passage_img": null, "options": ["The x component of displacement of the center of mass of the block M is: -mR/(M+m)", "The position of the point mass is: x = -√2 · mR/(M+m)", "The velocity of the point mass m is: v = √(2gR/(1+m/M))", "The velocity of the block M is: V = -m/M · √(2gR)"], "grading": {"kind": "msq", "accept": ["A", "C"]}}, {"id": "JEEADV2017_P1_P04", "q_num": 4, "subject": "Physics", "section": 1, "type": "msq", "type_label": "One or More Correct", "marks": 4.0, "neg": -2.0, "partial": true, "chapter": "Moving Charges and Magnetism", "q_img": "JEEADV2017_P1_P04_q.png", "sol_img": "JEEADV2017_P1_P04_sol.png", "passage_img": null, "options": ["The rate of change of the flux is maximum when the plane of the loops is perpendicular to plane of the paper.", "The net emf induced due to both the loops is proportional to cos ωt.", "The emf induced in the loop is proportional to the sum of the areas of the two loops.", "The amplitude of the maximum net emf induced due to both the loops is equal to the amplitude of maximum emf induced in the smaller loop alone."], "grading": {"kind": "msq", "accept": ["A", "D"]}}, {"id": "JEEADV2017_P1_P05", "q_num": 5, "subject": "Physics", "section": 1, "type": "msq", "type_label": "One or More Correct", "marks": 4.0, "neg": -2.0, "partial": true, "chapter": "Ray Optics and Optical Instruments", "q_img": "JEEADV2017_P1_P05_q.png", "sol_img": "JEEADV2017_P1_P05_sol.png", "passage_img": null, "options": ["At minimum deviation, the incident angle i₁ and the refracting angle r₁ at the first refracting surface are related by r₁ = (i₁/2).", "For this prism the refractive index μ and the angle of prism A are related as A = (1/2)cos⁻¹(μ/2).", "For this prism, the emergent ray at the second surface will be tangential to the surface when the angle of incidence at the first surface is i₁ = sin⁻¹[sin A√(4cos²(A/2) - 1 - cos A)].", "For the angle of incidence i₁ = A, the ray inside the prism is parallel to the base of the prism."], "grading": {"kind": "msq", "accept": ["A", "C", "D"]}}, {"id": "JEEADV2017_P1_P06", "q_num": 6, "subject": "Physics", "section": 1, "type": "msq", "type_label": "One or More Correct", "marks": 4.0, "neg": -2.0, "partial": true, "chapter": "Alternating Current", "q_img": "JEEADV2017_P1_P06_q.png", "sol_img": "JEEADV2017_P1_P06_sol.png", "passage_img": null, "options": ["The frequency at which the current will be in the phase with the voltage is independent of R.", "At ω→0 the current flowing through the circuit becomes nearly zero.", "At ω >> 10⁶ rad.s⁻¹, the circuit behave like a capacitor.", "The current will be in phase with the voltage if ω = 10⁴ rad.s⁻¹"], "grading": {"kind": "msq", "accept": ["A", "B"]}}, {"id": "JEEADV2017_P1_P07", "q_num": 7, "subject": "Physics", "section": 1, "type": "msq", "type_label": "One or More Correct", "marks": 4.0, "neg": -2.0, "partial": true, "chapter": "Current Electricity", "q_img": "JEEADV2017_P1_P07_q.png", "sol_img": "JEEADV2017_P1_P07_sol.png", "passage_img": null, "options": ["The resistive force experienced by the plate is proportional to v", "The pressure difference between the leading and trailing faces of the plate is proportional to uv", "The plate will continue to move with constant non-zero acceleration, at all times", "At a later time the external force F balances the resistive force."], "grading": {"kind": "msq", "accept": ["A", "B", "D"]}}]}, {"key": ["Physics", 2], "subject": "Physics", "section": 2, "type_label": "Numerical", "questions": [{"id": "JEEADV2017_P1_P08", "q_num": 8, "subject": "Physics", "section": 2, "type": "nat", "type_label": "Numerical", "marks": 4.0, "neg": 0.0, "partial": false, "chapter": "Mechanical Properties of Fluids", "q_img": "JEEADV2017_P1_P08_q.png", "sol_img"